i> <p> <code> <i>mm</i> </code> is the 2-digit minutes</p> </li> <li> <p> <code> <i>ss</i> </code> is the 2-digit seconds</p> </li> </ul>", "summary": null, "domain_schemas": ["BucketName", "ConflictException", "CreateSnapshotOutput", "ObjectKeyPrefix"], "name_tokens": ["create", "snapshot"], "path_tokens": ["createsnapshot"], "param_tokens": ["256", "algorithm", "amz", "content", "credential", "date", "headers", "security", "sha", "signature", "signed", "token", "x"], "schema_tokens": ["bucket", "conflict", "create", "exception", "key", "name", "object", "output", "prefix", "snapshot"], "T": "[METHOD] post [NAME] create snapshot [PATH] createsnapshot [PARAMS] 256 algorithm amz content credential date headers security sha signature signed token x [SCHEMA] bucket conflict create exception key name object output prefix snapshot"}, {"op_key": "POST /startapp", "method": "POST", "path": "/startapp", "operation_id": "StartApp", "param_names": ["X-Amz-Algorithm", "X-Amz-Content-Sha256", "X-Amz-Credential", "X-Amz-Date", "X-Amz-Security-Token", "X-Amz-Signature", "X-Amz-SignedHeaders"], "schema_names": ["AccessDeniedException", "ConflictException", "InternalServerException", "LaunchCommandList", "NonEmptyString", "ServiceQuotaExceededException", "SimSpaceWeaverResourceName", "StartAppOutput", "ValidationException"], "description": "Starts a custom app with the configuration specified in the simulation schema.", "summary": null, "domain_schemas": ["ConflictException", "LaunchCommandList", "NonEmptyString", "ServiceQuotaExceededException", "SimSpaceWeaverResourceName", "StartAppOutput"], "name_tokens": ["start", "app"], "path_tokens": ["startapp"], "param_tokens": ["256", "algorithm", "amz", "content", "credential", "date", "headers", "security", "sha", "signature", "signed", "token", "x"], "schema_tokens": ["app", "command", "conflict", "empty", "exceeded", "exception", "launch", "list", "name", "non", "output", "quota", "resource", "service", "sim", "space", "start", "stri