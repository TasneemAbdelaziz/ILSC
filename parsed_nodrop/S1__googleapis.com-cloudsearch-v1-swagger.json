ve", "param_names": ["$.xgafv", "access_token", "alt", "callback", "fields", "key", "name", "oauth_token", "prettyPrint", "quotaUser", "uploadType", "upload_protocol"], "schema_names": ["DebugOptions", "Operation", "Status", "UnreserveItemsRequest"], "description": "Unreserves all items from a queue, making them all eligible to be\npolled.  This method is useful for resetting the indexing queue\nafter a connector has been restarted.", "summary": null, "domain_schemas": ["DebugOptions", "Operation", "UnreserveItemsRequest"], "name_tokens": ["cloudsearch", "indexing", "datasources", "items", "unreserve"], "path_tokens": ["indexing", "items", "unreserve"], "param_tokens": ["access", "alt", "callback", "fields", "key", "name", "oauth", "pretty", "print", "protocol", "quota", "token", "type", "upload", "user", "xgafv"], "schema_tokens": ["debug", "items", "operation", "options", "request", "unreserve"], "T": "[METHOD] post [NAME] cloudsearch indexing datasources items unreserve [PATH] indexing items unreserve [PARAMS] access alt callback fields key name oauth pretty print protocol quota token type upload user xgafv [SCHEMA] debug items operation options request unreserve"}, {"op_key": "POST /v1/indexing/{name}:index", "method": "POST", "path": "/v1/indexing/{name}:index", "operation_id": "cloudsearch.indexing.datasources.items.index", "param_names": ["$.xgafv", "access_token", "alt", "callback", "fields", "key", "name", "oauth_token", "prettyPrint", "quotaUser", "uploadType", "upload_protocol"], "schema_names": ["DebugOptions", "IndexItemOptions", "IndexItemRequest", "Item", "ItemAcl", "ItemContent", "ItemMetadata", "ItemStatus", "ItemStructuredData", "Operation", "SearchQualityMetadata", "Status", "StructuredDataObject", "UploadItemRef"], "description": "Updates Item ACL, metadata, and\ncontent. It will insert the Item if it\ndoes not exist.\nThis method does not support partial updates.  Fields with no provided\nvalues are cleared out in the Cloud Search index.", "summ